# Local dev: leave unset to use Vite proxy (5173 → API on 3000). Run `npm run dev:all`.
# Do NOT set to http://localhost:3000 unless the API server is always running.
# VITE_API_URL=

ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=
TAVILY_API_KEY=
ADMIN_EMAIL=admin@example.com
VITE_ADMIN_EMAIL=admin@example.com
# Optional: muted looping hero MP4 URL or path (e.g. `/videos/hero-ambient.mp4`). If unset, the hero uses an animated gradient only.
# VITE_HERO_VIDEO_URL=
